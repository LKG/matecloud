<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>vip.mate</groupId>
        <artifactId>mate-starters</artifactId>
        <version>5.0.8</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>mate-file-starter</artifactId>
    <packaging>jar</packaging>
    <name>mate-file-starter</name>
    <description>MateCloud File Starter - pluggable object storage SPI (FileStorage/FileTemplate) with bundled MinIO provider</description>

    <dependencies>
        <dependency>
            <groupId>vip.mate</groupId>
            <artifactId>mate-base</artifactId>
        </dependency>
        <!-- AWS SDK v2 (S3 + presigner) drives all S3-compatible object-storage ops (MinIO/OSS/AWS).
             Exclude the bundled HTTP clients: we use the lightweight url-connection-client (sync) and
             never the async client, so apache5-client (a 2nd sync impl → "multiple HTTP implementations"
             ambiguity) and netty-nio-client (async, unused & heavy) are excluded. The server only does
             control-plane + small ops here; large bytes go browser→storage via pre-signed URLs. -->
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>s3</artifactId>
            <exclusions>
                <exclusion>
                    <groupId>software.amazon.awssdk</groupId>
                    <artifactId>apache5-client</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>software.amazon.awssdk</groupId>
                    <artifactId>netty-nio-client</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>url-connection-client</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-autoconfigure-processor</artifactId>
            <optional>true</optional>
        </dependency>
    </dependencies>
</project>

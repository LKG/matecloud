<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>vip.mate</groupId>
        <artifactId>mate-common</artifactId>
        <version>5.0.8</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>mate-base</artifactId>
    <packaging>jar</packaging>
    <name>mate-base</name>
    <description>Base types - entities, results, exceptions, requests</description>

    <dependencies>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-annotations</artifactId>
        </dependency>
        <!--
            NOTE: mate-base is a pure-type module and intentionally does NOT depend
            on mybatis-plus-annotation. Persistence mapping annotations
            (@TableId/@TableField/@TableLogic/@Version) live on the infrastructure
            *PO classes, not on domain entities. See BaseEntity / BasePO.
        -->
        <dependency>
            <groupId>jakarta.validation</groupId>
            <artifactId>jakarta.validation-api</artifactId>
        </dependency>
        <!--
            SLF4J 门面 (纯 API, 非框架): 供 MateTrace 操作 MDC。
            日志实现由各服务自带的 logback 提供, 此处只引门面。
        -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>
    </dependencies>

</project>
